<Window x:Class="DragonDeskPet.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="操作确认" Width="410" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="17,9" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#EEE8F7" />
            <Setter Property="Foreground" Value="#584A6D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E0D5F0" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D3C4E9" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource CancelButtonStyle}">
            <Setter Property="Background" Value="#B35D7A" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A84F6E" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#923F5C" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Padding="21" Background="#FFFCFF" BorderBrush="#D9CEEB" BorderThickness="1" CornerRadius="18">
        <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.2" Color="#493B61" /></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="10" Background="#F8E7ED" VerticalAlignment="Center">
                    <TextBlock Text="!" FontSize="17" FontWeight="Bold" Foreground="#A84F6E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="17" FontWeight="SemiBold" Foreground="#403653" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Grid.Column="2" Content="×" Padding="0" Width="27" Height="27" FontSize="15"
                        Style="{StaticResource CancelButtonStyle}" Click="Cancel_Click" ToolTip="取消" />
            </Grid>
            <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" LineHeight="21" FontSize="12.5"
                       Foreground="#6A5F77" Margin="0,15,0,20" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" IsDefault="True"
                        Style="{StaticResource CancelButtonStyle}" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource ConfirmButtonStyle}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
