<Window x:Class="DragonDeskPet.CourseImportPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DragonDeskPet"
        Title="课程导入预览" Width="560" Height="490" MinWidth="510" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F5F1FA" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <local:CourseImportStatusConverter x:Key="ImportStatus" />
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="PreviewButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Background" Value="#ECE6F7" />
            <Setter Property="Foreground" Value="#55456B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.68" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PreviewPrimaryButton" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="#8466D3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PreviewReplaceButton" TargetType="Button" BasedOn="{StaticResource PreviewButton}">
            <Setter Property="Background" Value="#F6E5EB" />
            <Setter Property="Foreground" Value="#A84F6E" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter ContentSource="Content" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="2,0,2,14">
            <TextBlock Text="课程导入预览" FontSize="20" FontWeight="SemiBold" Foreground="#403653" />
            <TextBlock Text="先检查结果；只有点击合并或确认替换后，才会修改本机课表。"
                       FontSize="11" Foreground="#81758E" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#E4DAF1" BorderThickness="1"
                CornerRadius="14" Padding="13,11" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="预览统计" FontSize="12" FontWeight="SemiBold" Foreground="#403653" />
                <TextBlock x:Name="SummaryText" FontSize="13" Foreground="#6B5689" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4DAF1" BorderThickness="1" CornerRadius="14" Padding="10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="课程明细" FontSize="12" FontWeight="SemiBold" Foreground="#403653" Margin="5,2,0,9" />
                <ListBox x:Name="RowsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         Padding="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource CourseVerticalScrollBar}" />
                    </ListBox.Resources>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FCFAFF" BorderBrush="#E8DFF3" BorderThickness="1"
                                    CornerRadius="11" Padding="11,9">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SourceDescription}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#403653" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourceDescription}" />
                                        <StackPanel Visibility="{Binding HasCourse, Converter={StaticResource BoolVisibility}}"
                                                    Margin="0,5,0,0">
                                            <TextBlock Text="{Binding ScheduleText}" FontSize="11" Foreground="#62556F"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LocationTeacherText}" FontSize="11" Foreground="#62556F"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ReminderText}" FontSize="11" Foreground="#81758E"
                                                       TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Foreground="#B34B69"
                                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#EEE8FA" CornerRadius="9" Padding="9,4"
                                            Margin="10,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Disposition, Converter={StaticResource ImportStatus}}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="#7055AC" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="1,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="EmptyNotice" Text="没有可导入的新增或更新课程。"
                       FontSize="11" Foreground="#A84F6E" VerticalAlignment="Center" Visibility="Collapsed" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource PreviewButton}" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="MergeButton" Content="合并导入" Style="{StaticResource PreviewPrimaryButton}" Click="Merge_Click" />
                <Button x:Name="ReplaceButton" Content="替换当前学期" Style="{StaticResource PreviewReplaceButton}" Click="Replace_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
