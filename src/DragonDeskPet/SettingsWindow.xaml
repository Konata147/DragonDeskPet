<Window x:Class="DragonDeskPet.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="龙娘桌宠设置"
        Width="548" Height="700"
        MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F1FA"
        ShowInTaskbar="False"
        FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <SolidColorBrush x:Key="SettingsText" Color="#403653" />
        <SolidColorBrush x:Key="SettingsMuted" Color="#81758E" />
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#ECE6F7" />
            <Setter Property="Foreground" Value="#55456B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#DFD4F2" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D2C3EC" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimarySettingsButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Background" Value="#8466D3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#7558C4" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#674AAD" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#FDFBFF" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="BorderBrush" Value="#D7CCEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9275DC" /><Setter TargetName="Surface" Property="Background" Value="White" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#FDFBFF" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="BorderBrush" Value="#D7CCEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9275DC" /><Setter TargetName="Surface" Property="Background" Value="White" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#FDFBFF" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="BorderBrush" Value="#D7CCEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface" Background="#FDFBFF" BorderBrush="#D7CCEA" BorderThickness="1" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="10,0,5,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Border Grid.Column="1" Margin="4" Background="#EEE8FA" CornerRadius="8">
                                                    <Path x:Name="Arrow" Width="9" Height="5" Stretch="Fill" Fill="#7258AE" Data="M 0 0 L 4.5 5 L 9 0 Z" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#B7A4DF" /></Trigger>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#9275DC" /><Setter TargetName="Arrow" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" CenterX="4.5" CenterY="2.5" /></Setter.Value></Setter></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   PlacementTarget="{Binding ElementName=DropDownToggle}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="270"
                                        Margin="0,5,0,0"
                                        Padding="6"
                                        Background="#FFFCFF"
                                        BorderBrush="#D7CCEA"
                                        BorderThickness="1"
                                        CornerRadius="13">
                                    <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.2" Color="#4A3C62" /></Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EEE7FA" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#E3D8F7" /><Setter Property="Foreground" Value="#6749B0" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#665A73" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="1,0,0,5" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SettingsText}" />
        </Style>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#FCFAFF" />
            <Setter Property="BorderBrush" Value="#E1D8EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="102"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#E9E0FA" Offset="0"/><GradientStop Color="#F8F4FF" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="21" Background="#8466D3" VerticalAlignment="Center">
                    <TextBlock Text="✦" Foreground="White" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="桌宠设置" FontSize="22" FontWeight="SemiBold" Foreground="#3A304A" />
                    <TextBlock Text="调整她的 AI 大脑、桌面表现和效率助手" Margin="0,4,0,0" Foreground="#7D708A" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16,22,4">
            <StackPanel>
                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <Border Width="30" Height="30" CornerRadius="10" Background="#EEE7FA" Margin="0,0,9,0"><TextBlock Text="AI" FontSize="11" FontWeight="Bold" Foreground="#7258B4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="AI 大脑" Style="{StaticResource CardTitle}"/><TextBlock Text="可选择云端接口，也可以使用无需密钥的本地模型" FontSize="10.5" Foreground="{StaticResource SettingsMuted}" Margin="0,2,0,0"/></StackPanel>
                        </DockPanel>
                        <TextBlock Text="提供商" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ProviderBox" Margin="0,0,0,11" SelectedValuePath="Id" SelectionChanged="ProviderBox_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ModelTextBox" Margin="0,0,0,11" />
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="BaseUrlTextBox" Margin="0,0,0,11" />
                        <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox x:Name="ApiKeyBox" Margin="0,0,0,6" />
                        <TextBlock x:Name="ApiKeyHintText" Text="只保存在本机，并使用当前 Windows 用户身份加密。" FontSize="10.5" Foreground="{StaticResource SettingsMuted}" TextWrapping="Wrap" LineHeight="17" />
                        <Border x:Name="ProviderHintPanel" Margin="0,9,0,0" Padding="10" Background="#F0EBFA" CornerRadius="10" Visibility="Collapsed">
                            <TextBlock x:Name="ProviderHintText" FontSize="10.5" Foreground="#66557C" TextWrapping="Wrap" LineHeight="17" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <Border Width="30" Height="30" CornerRadius="10" Background="#EEE7FA" Margin="0,0,9,0"><TextBlock Text="♢" FontSize="17" Foreground="#7258B4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="桌宠" Style="{StaticResource CardTitle}"/><TextBlock Text="控制桌面上的大小、层级与启动方式" FontSize="10.5" Foreground="{StaticResource SettingsMuted}" Margin="0,2,0,0"/></StackPanel>
                        </DockPanel>
                        <DockPanel Margin="1,0,1,3"><TextBlock Text="角色缩放" Foreground="#665A73"/><Border DockPanel.Dock="Right" Background="#EEE7FA" CornerRadius="9" Padding="8,3"><TextBlock x:Name="ScaleValueText" Foreground="#6F54B4" FontWeight="SemiBold"/></Border></DockPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.6" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="ScaleSlider_ValueChanged" Margin="0,5,0,10" />
                        <CheckBox x:Name="AlwaysOnTopBox" Content="始终置顶" />
                        <CheckBox x:Name="AutoHideInFullscreenBox" Content="全屏程序运行时自动隐藏" />
                        <TextBlock Text="离开全屏后静默恢复；手动隐藏时不会自动弹出。" Margin="21,-2,0,3" FontSize="10.5" Foreground="{StaticResource SettingsMuted}" TextWrapping="Wrap" />
                        <CheckBox x:Name="StartWithWindowsBox" Content="登录 Windows 时自动启动" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <Border Width="30" Height="30" CornerRadius="10" Background="#EEE7FA" Margin="0,0,9,0"><TextBlock Text="◷" FontSize="18" Foreground="#7258B4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <StackPanel><TextBlock Text="效率助手" Style="{StaticResource CardTitle}"/><TextBlock Text="提醒声音和番茄钟默认值" FontSize="10.5" Foreground="{StaticResource SettingsMuted}" Margin="0,2,0,0"/></StackPanel>
                        </DockPanel>
                        <CheckBox x:Name="ReminderSoundBox" Content="提醒时播放一次轻柔提示音" Margin="0,1,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="专注时长（分钟）" VerticalAlignment="Center" Foreground="#665A73"/><TextBox x:Name="FocusMinutesBox" Grid.Column="1" Margin="3"/>
                            <TextBlock Grid.Row="1" Text="短休息（分钟）" VerticalAlignment="Center" Foreground="#665A73"/><TextBox x:Name="ShortBreakMinutesBox" Grid.Row="1" Grid.Column="1" Margin="3"/>
                            <TextBlock Grid.Row="2" Text="长休息（分钟）" VerticalAlignment="Center" Foreground="#665A73"/><TextBox x:Name="LongBreakMinutesBox" Grid.Row="2" Grid.Column="1" Margin="3"/>
                            <TextBlock Grid.Row="3" Text="每几轮进入长休息" VerticalAlignment="Center" Foreground="#665A73"/><TextBox x:Name="RoundsBeforeLongBreakBox" Grid.Row="3" Grid.Column="1" Margin="3"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="ValidationPanel" Background="#FFF1F4" BorderBrush="#F0C5D0" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,8" Visibility="Collapsed">
                    <TextBlock x:Name="ValidationText" Foreground="#A3405C" TextWrapping="Wrap" LineHeight="18" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#FBF9FE" BorderBrush="#E2D9EE" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="18,0">
                <Button Content="取消" MinWidth="82" Click="CancelButton_Click" />
                <Button Content="保存设置" MinWidth="104" Style="{StaticResource PrimarySettingsButton}" Click="SaveButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
