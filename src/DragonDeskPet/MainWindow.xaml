<Window x:Class="DragonDeskPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="龙娘桌宠"
        Width="710" Height="510"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <Style x:Key="QuickIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#6B578F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E7DDF8" />
                                <Setter Property="Foreground" Value="#513A7D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D7C6F1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickMoreButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#6B578F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E7DDF8" />
                                <Setter Property="Foreground" Value="#513A7D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#DCCEF3" />
                                <Setter Property="Foreground" Value="#4E3779" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickMoreItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#493960" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#ECE4FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCCEF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="PetMenu" Closed="PetMenu_Closed">
            <MenuItem Header="💬 和我聊天" Click="ChatMenuItem_Click" />
            <MenuItem Header="📷 截图问我" Tag="Screenshot" Click="ScreenshotMenuItem_Click" />
            <MenuItem Header="📋 剪贴板问我" Tag="Clipboard" Click="ClipboardMenuItem_Click" />
            <MenuItem Header="📌 始终置顶" IsCheckable="True" Tag="Topmost" Click="TopmostMenuItem_Click" />
            <Separator />
            <MenuItem Header="⚙ 设置" Click="SettingsMenuItem_Click" />
            <MenuItem Header="🙈 隐藏" Click="HideMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Border x:Name="OnboardingBubble"
                Panel.ZIndex="4"
                Width="276"
                Margin="0,0,145,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FAF8FF"
                BorderBrush="#BFAEEA"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#3F315C" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="初次见面～"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,9,0,10"
                           Text="拖动我可以移动位置，滚轮调整大小，双击打开聊天；截图、剪贴板和图片拖入都可以问我。"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Foreground="#514761" />
                <Button Content="知道了"
                        HorizontalAlignment="Right"
                        MinWidth="78"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="OnboardingDone_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="ChatBubble"
                Width="270"
                Margin="0,18,150,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#F7F4FF"
                BorderBrush="#CBBDF1"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#3F315C" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="小龙娘" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    <Button DockPanel.Dock="Right" Content="×" Width="28" Height="24" Padding="0" Click="CloseChat_Click" />
                </DockPanel>
                <Border x:Name="ScreenshotPreviewPanel"
                        Grid.Row="1"
                        Margin="0,9,0,0"
                        Padding="7"
                        Background="#EEE8FA"
                        BorderBrush="#CBBDF1"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="82" Height="56" Background="#DDD5EB" CornerRadius="7" ClipToBounds="True">
                            <Image x:Name="ScreenshotPreviewImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,2,5,0">
                            <TextBlock x:Name="PendingImageTitleText"
                                       Text="待发送图片"
                                       FontWeight="SemiBold"
                                       Foreground="#403653"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ScreenshotDimensionsText"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#716681" />
                        </StackPanel>
                        <Button x:Name="RemoveScreenshotButton"
                                Grid.Column="2"
                                Width="27" Height="27" Padding="0"
                                ToolTip="移除截图"
                                Content="×"
                                Click="RemoveScreenshot_Click" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseText"
                               Text="今天想让我帮你做什么？"
                               TextWrapping="Wrap"
                               Foreground="#403653"
                               FontSize="13"
                               LineHeight="20" />
                </ScrollViewer>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox"
                             MinHeight="36"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBBDF1"
                             BorderThickness="1"
                             Background="White"
                             KeyDown="PromptBox_KeyDown" />
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="发送"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            Click="SendButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="QuickBar"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,86,180,0"
              Opacity="0"
              RenderTransformOrigin="1,0.5"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="QuickBarScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Background="#F2FBF9FF"
                    BorderBrush="#B8A6DE"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#57446F" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE8BD;"
                            ToolTip="聊天"
                            Click="ChatMenuItem_Click" />
                    <Button x:Name="QuickScreenshotButton"
                            Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE722;"
                            ToolTip="截图问我"
                            Click="ScreenshotMenuItem_Click" />
                    <Button x:Name="QuickClipboardButton"
                            Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE77F;"
                            ToolTip="粘贴问我"
                            Click="ClipboardMenuItem_Click" />
                    <ToggleButton x:Name="QuickMoreButton"
                                  Style="{StaticResource QuickMoreButtonStyle}"
                                  Content="&#xE712;"
                                  ToolTip="更多" />
                </StackPanel>
            </Border>
            <Popup x:Name="QuickMorePopup"
                   PlacementTarget="{Binding ElementName=QuickMoreButton}"
                   Placement="Bottom"
                   HorizontalOffset="-92"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsChecked, ElementName=QuickMoreButton, Mode=TwoWay}">
                <Border Width="132"
                        Padding="6"
                        Background="#FAF8FF"
                        BorderBrush="#B8A6DE"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#57446F" />
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="QuickTopmostButton"
                                Style="{StaticResource QuickMoreItemStyle}"
                                Content="✓  始终置顶"
                                Click="TopmostMenuItem_Click" />
                        <Button Style="{StaticResource QuickMoreItemStyle}"
                                Content="⚙  设置"
                                Click="SettingsMenuItem_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid x:Name="CharacterHost"
              Width="168" Height="220"
              AllowDrop="True"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,130,54"
              RenderTransformOrigin="0.5,0.85"
              ContextMenu="{StaticResource PetMenu}"
              MouseEnter="CharacterHost_MouseEnter"
              MouseLeave="CharacterHost_MouseLeave"
              LostMouseCapture="CharacterHost_LostMouseCapture"
              MouseLeftButtonDown="CharacterHost_MouseLeftButtonDown"
              MouseLeftButtonUp="CharacterHost_MouseLeftButtonUp"
              MouseMove="CharacterHost_MouseMove"
              MouseWheel="CharacterHost_MouseWheel"
              MouseRightButtonUp="CharacterHost_MouseRightButtonUp"
              DragEnter="CharacterHost_DragEnter"
              DragOver="CharacterHost_DragOver"
              DragLeave="CharacterHost_DragLeave"
              Drop="CharacterHost_Drop">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetUserScaleTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="PetStateScaleTransform" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotateTransform" Angle="0" />
                    <TranslateTransform x:Name="PetTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="CharacterImage"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Viewbox x:Name="PlaceholderCharacter" Stretch="Uniform">
                <Canvas Width="160" Height="210">
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M30,100 C2,89 4,150 30,142 C13,137 20,119 43,126 Z" />
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M130,100 C158,89 156,150 130,142 C147,137 140,119 117,126 Z" />
                    <Path Fill="#EFE8FF" Stroke="#8067AD" StrokeThickness="2"
                          Data="M112,145 C154,151 151,190 121,181 C142,177 141,162 116,164 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M49,43 C30,4 54,8 66,38 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M111,43 C130,4 106,8 94,38 Z" />
                    <Ellipse Canvas.Left="33" Canvas.Top="27" Width="94" Height="96" Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2" />
                    <Path Fill="#EEE8F8" Data="M36,70 C40,28 120,24 126,69 C111,52 105,49 95,44 C89,58 70,61 52,55 C49,66 45,77 38,84 Z" />
                    <Ellipse Canvas.Left="55" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="93" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="59" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Ellipse Canvas.Left="97" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Path Stroke="#9B7FBB" StrokeThickness="2" Data="M73,99 Q80,104 87,99" />
                    <Path Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2"
                          Data="M58,111 Q80,103 102,111 L119,188 Q80,205 41,188 Z" />
                    <Path Fill="#DCCDF6" Data="M58,113 Q80,126 102,113 L108,145 Q80,156 52,145 Z" />
                    <Ellipse Canvas.Left="72" Canvas.Top="128" Width="16" Height="16" Fill="#8ECFE8" Stroke="#5C91B1" StrokeThickness="1" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M48,132 Q31,147 39,165" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M112,132 Q129,147 121,165" />
                    <Ellipse Canvas.Left="38" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                    <Ellipse Canvas.Left="84" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                </Canvas>
            </Viewbox>

            <Border x:Name="CharacterHitArea" Background="#01000000" CornerRadius="70" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="#D9443659" CornerRadius="10" Padding="8,3" IsHitTestVisible="False">
                <TextBlock x:Name="StateText" Text="待机" Foreground="White" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
