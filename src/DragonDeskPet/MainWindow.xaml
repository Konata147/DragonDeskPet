<Window x:Class="DragonDeskPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="龙娘桌宠"
        Width="430" Height="310"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <ContextMenu x:Key="PetMenu" Closed="PetMenu_Closed">
            <MenuItem Header="💬 和我聊天" Click="ChatMenuItem_Click" />
            <MenuItem Header="📌 始终置顶" IsCheckable="True" Tag="Topmost" Click="TopmostMenuItem_Click" />
            <Separator />
            <MenuItem Header="⚙ 设置" Click="SettingsMenuItem_Click" />
            <MenuItem Header="🙈 隐藏" Click="HideMenuItem_Click" />
            <Separator />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Border x:Name="OnboardingBubble"
                Panel.ZIndex="4"
                Width="276"
                Margin="0,0,145,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FAF8FF"
                BorderBrush="#BFAEEA"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#3F315C" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="初次见面～"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,9,0,10"
                           Text="拖动我可以移动位置，滚轮调整大小，双击打开聊天，右键查看更多功能。"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Foreground="#514761" />
                <Button Content="知道了"
                        HorizontalAlignment="Right"
                        MinWidth="78"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="OnboardingDone_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="ChatBubble"
                Width="270"
                Margin="0,18,150,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#F7F4FF"
                BorderBrush="#CBBDF1"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#3F315C" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="小龙娘" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    <Button DockPanel.Dock="Right" Content="×" Width="28" Height="24" Padding="0" Click="CloseChat_Click" />
                </DockPanel>
                <ScrollViewer Grid.Row="1" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseText"
                               Text="今天想让我帮你做什么？"
                               TextWrapping="Wrap"
                               Foreground="#403653"
                               FontSize="13"
                               LineHeight="20" />
                </ScrollViewer>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox"
                             MinHeight="36"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBBDF1"
                             BorderThickness="1"
                             Background="White"
                             KeyDown="PromptBox_KeyDown" />
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="发送"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            Click="SendButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <StackPanel x:Name="QuickBar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,12,12,0"
                    Visibility="Collapsed">
            <Border Background="#EFFFFFFF" CornerRadius="14" Padding="4">
                <StackPanel Orientation="Horizontal">
                    <Button Content="聊天" Click="ChatMenuItem_Click" />
                    <Button Content="置顶" Click="TopmostMenuItem_Click" />
                    <Button Content="设置" Click="SettingsMenuItem_Click" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid x:Name="CharacterHost"
              Width="168" Height="220"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,0,4"
              RenderTransformOrigin="0.5,0.85"
              ContextMenu="{StaticResource PetMenu}"
              MouseEnter="CharacterHost_MouseEnter"
              MouseLeave="CharacterHost_MouseLeave"
              LostMouseCapture="CharacterHost_LostMouseCapture"
              MouseLeftButtonDown="CharacterHost_MouseLeftButtonDown"
              MouseLeftButtonUp="CharacterHost_MouseLeftButtonUp"
              MouseMove="CharacterHost_MouseMove"
              MouseWheel="CharacterHost_MouseWheel"
              MouseRightButtonUp="CharacterHost_MouseRightButtonUp">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetUserScaleTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="PetStateScaleTransform" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotateTransform" Angle="0" />
                    <TranslateTransform x:Name="PetTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="CharacterImage"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Viewbox x:Name="PlaceholderCharacter" Stretch="Uniform">
                <Canvas Width="160" Height="210">
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M30,100 C2,89 4,150 30,142 C13,137 20,119 43,126 Z" />
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M130,100 C158,89 156,150 130,142 C147,137 140,119 117,126 Z" />
                    <Path Fill="#EFE8FF" Stroke="#8067AD" StrokeThickness="2"
                          Data="M112,145 C154,151 151,190 121,181 C142,177 141,162 116,164 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M49,43 C30,4 54,8 66,38 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M111,43 C130,4 106,8 94,38 Z" />
                    <Ellipse Canvas.Left="33" Canvas.Top="27" Width="94" Height="96" Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2" />
                    <Path Fill="#EEE8F8" Data="M36,70 C40,28 120,24 126,69 C111,52 105,49 95,44 C89,58 70,61 52,55 C49,66 45,77 38,84 Z" />
                    <Ellipse Canvas.Left="55" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="93" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="59" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Ellipse Canvas.Left="97" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Path Stroke="#9B7FBB" StrokeThickness="2" Data="M73,99 Q80,104 87,99" />
                    <Path Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2"
                          Data="M58,111 Q80,103 102,111 L119,188 Q80,205 41,188 Z" />
                    <Path Fill="#DCCDF6" Data="M58,113 Q80,126 102,113 L108,145 Q80,156 52,145 Z" />
                    <Ellipse Canvas.Left="72" Canvas.Top="128" Width="16" Height="16" Fill="#8ECFE8" Stroke="#5C91B1" StrokeThickness="1" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M48,132 Q31,147 39,165" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M112,132 Q129,147 121,165" />
                    <Ellipse Canvas.Left="38" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                    <Ellipse Canvas.Left="84" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                </Canvas>
            </Viewbox>

            <Border x:Name="CharacterHitArea" Background="#01000000" CornerRadius="70" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="#D9443659" CornerRadius="10" Padding="8,3" IsHitTestVisible="False">
                <TextBlock x:Name="StateText" Text="待机" Foreground="White" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
