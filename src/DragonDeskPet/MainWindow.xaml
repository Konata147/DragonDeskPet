<Window x:Class="DragonDeskPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="龙娘桌宠"
        Width="830" Height="590"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Interaction_PreviewKeyDown"
        Closing="Window_Closing"
        LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <Style x:Key="PetChoiceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FFFBFF" />
            <Setter Property="BorderBrush" Value="#D2C0EA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChoiceSurface" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#EFE5FB" />
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#9875C8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceSurface" Property="Background" Value="#DDCCF3" />
                                <Setter TargetName="ChoiceSurface" Property="BorderBrush" Value="#7653AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetPropButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFDFC" />
            <Setter Property="BorderBrush" Value="#BDA7DF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PropSurface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <Border.Effect>
                                <DropShadowEffect Color="#684B91" BlurRadius="5"
                                                  ShadowDepth="1" Opacity="0.25" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PropSurface" Property="Background" Value="#F0E6FF" />
                                <Setter TargetName="PropSurface" Property="BorderBrush" Value="#8E6AC4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PropSurface" Property="Background" Value="#DDCDF5" />
                                <Setter TargetName="PropSurface" Property="BorderBrush" Value="#7652AD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#6B578F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E7DDF8" />
                                <Setter Property="Foreground" Value="#513A7D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D7C6F1" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickMoreButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#6B578F" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#E7DDF8" />
                                <Setter Property="Foreground" Value="#513A7D" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#DCCEF3" />
                                <Setter Property="Foreground" Value="#4E3779" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickMoreItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#493960" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ItemSurface"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#ECE4FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#DCCEF3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="#493D5D" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                                <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <TextBlock x:Name="CheckMark" Grid.Column="1" Text="✓" FontWeight="SemiBold" Foreground="#7657C4" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#EEE7FA" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#DFD3F4" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="9" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Separator"><Grid><Border Height="1" Background="#E5DDEF" VerticalAlignment="Center" /></Grid></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PetContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Width="192" Padding="7" Background="#FCFAFF" BorderBrush="#D8CCEA" BorderThickness="1" CornerRadius="16">
                            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.24" Color="#4A3C62" /></Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="PetMenu"
                     Style="{StaticResource PetContextMenuStyle}"
                     ItemContainerStyle="{StaticResource PetMenuItemStyle}"
                     Closed="PetMenu_Closed">
            <MenuItem Header="💬 和我聊天" Click="ChatMenuItem_Click" />
            <MenuItem Header="♡ 陪我玩" Click="InteractMenuItem_Click" />
            <MenuItem Header="📷 截图问我" Tag="Screenshot" Click="ScreenshotMenuItem_Click" />
            <MenuItem Header="📋 剪贴板问我" Tag="Clipboard" Click="ClipboardMenuItem_Click" />
            <MenuItem Header="⏱ 效率助手" Click="ProductivityMenuItem_Click" />
            <MenuItem Header="📌 始终置顶" IsCheckable="True" Tag="Topmost" Click="TopmostMenuItem_Click" />
            <Separator Style="{StaticResource PetMenuSeparatorStyle}" />
            <MenuItem Header="⚙ 设置" Click="SettingsMenuItem_Click" />
            <MenuItem Header="🙈 隐藏" Click="HideMenuItem_Click" />
            <Separator Style="{StaticResource PetMenuSeparatorStyle}" />
            <MenuItem Header="退出" Click="ExitMenuItem_Click" />
        </ContextMenu>
        <ContextMenu x:Key="InteractionMenu" Style="{StaticResource PetContextMenuStyle}"
                     ItemContainerStyle="{StaticResource PetMenuItemStyle}"
                     Opened="InteractionMenu_Opened" Closed="PetMenu_Closed">
            <MenuItem Header="✦  打招呼" Tag="Greet" Click="PetActivity_Click" />
            <MenuItem Header="♡  摸摸头" Tag="Pet" Click="PetActivity_Click" />
            <MenuItem Header="♪  喂点心" Tag="Feed" Click="PetActivity_Click" />
            <MenuItem Header="♡  贴贴" Tag="Cuddle" Click="PetActivity_Click" />
            <MenuItem Header="✧  蹦一蹦" Tag="Hop" Click="PetActivity_Click" />
            <MenuItem Header="♫  晃晃舞" Tag="Dance" Click="PetActivity_Click" />
            <MenuItem Header="✧  伸个懒腰" Tag="Stretch" Click="PetActivity_Click" />
            <Separator Style="{StaticResource PetMenuSeparatorStyle}" />
            <MenuItem Header="☾  打个盹" Tag="Rest" Click="PetActivity_Click" />
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="RootSurface">
        <local:ProductivityBubble x:Name="ProductivityPanel"
                                  xmlns:local="clr-namespace:DragonDeskPet"
                                  Panel.ZIndex="6"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,310,26"
                                  Visibility="Collapsed" />

        <Border x:Name="ReminderAlertCard"
                Panel.ZIndex="7"
                Width="310"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,310,30"
                Padding="14"
                Background="#FFF9F2"
                BorderBrush="#D9B878"
                BorderThickness="1"
                CornerRadius="18"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.25" Color="#594829" />
            </Border.Effect>
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="AlertTitleText" FontSize="15" FontWeight="SemiBold" Foreground="#4D3D2C" />
                    <TextBlock x:Name="AlertRemainingText" DockPanel.Dock="Right" Foreground="#89735B" FontSize="11" />
                </DockPanel>
                <TextBlock x:Name="AlertMessageText" Margin="0,8,0,10" TextWrapping="Wrap" FontSize="13" Foreground="#514536" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="稍后 5 分" Tag="5" Padding="8,5" Click="SnoozeAlert_Click" />
                    <Button Content="10 分" Tag="10" Padding="8,5" Click="SnoozeAlert_Click" />
                    <Button Content="30 分" Tag="30" Padding="8,5" Click="SnoozeAlert_Click" />
                    <Button Content="完成" Background="{StaticResource AccentBrush}" Foreground="White" Padding="10,5" Click="CompleteAlert_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border x:Name="OnboardingBubble"
                Panel.ZIndex="4"
                Width="276"
                Margin="0,0,145,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#FAF8FF"
                BorderBrush="#BFAEEA"
                BorderThickness="1"
                CornerRadius="18"
                Padding="16"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#3F315C" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="初次见面～"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" />
                <TextBlock Margin="0,9,0,10"
                           Text="拖动我可以移动位置，滚轮调整大小，双击打开聊天；截图、剪贴板和图片拖入都可以问我。"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Foreground="#514761" />
                <Button Content="知道了"
                        HorizontalAlignment="Right"
                        MinWidth="78"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Click="OnboardingDone_Click" />
            </StackPanel>
        </Border>

        <Border x:Name="ChatBubble"
                Width="270"
                Margin="0,18,150,26"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#F7F4FF"
                BorderBrush="#CBBDF1"
                BorderThickness="1"
                CornerRadius="18"
                Padding="14"
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#3F315C" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="小龙娘" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                    <Button DockPanel.Dock="Right" Content="×" Width="28" Height="24" Padding="0" Click="CloseChat_Click" />
                </DockPanel>
                <Border x:Name="ScreenshotPreviewPanel"
                        Grid.Row="1"
                        Margin="0,9,0,0"
                        Padding="7"
                        Background="#EEE8FA"
                        BorderBrush="#CBBDF1"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="82" Height="56" Background="#DDD5EB" CornerRadius="7" ClipToBounds="True">
                            <Image x:Name="ScreenshotPreviewImage"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,2,5,0">
                            <TextBlock x:Name="PendingImageTitleText"
                                       Text="待发送图片"
                                       FontWeight="SemiBold"
                                       Foreground="#403653"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ScreenshotDimensionsText"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="#716681" />
                        </StackPanel>
                        <Button x:Name="RemoveScreenshotButton"
                                Grid.Column="2"
                                Width="27" Height="27" Padding="0"
                                ToolTip="移除截图"
                                Content="×"
                                Click="RemoveScreenshot_Click" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" Margin="0,10,0,10" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ResponseText"
                               Text="今天想让我帮你做什么？"
                               TextWrapping="Wrap"
                               Foreground="#403653"
                               FontSize="13"
                               LineHeight="20" />
                </ScrollViewer>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PromptBox"
                             MinHeight="36"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CBBDF1"
                             BorderThickness="1"
                             Background="White"
                             KeyDown="PromptBox_KeyDown" />
                    <Button x:Name="SendButton"
                            Grid.Column="1"
                            Content="发送"
                            Background="{StaticResource AccentBrush}"
                            Foreground="White"
                            Click="SendButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="QuickBar"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Margin="0,86,180,0"
              Opacity="0"
              RenderTransformOrigin="1,0.5"
              Visibility="Collapsed">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="QuickBarScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border Background="#F2FBF9FF"
                    BorderBrush="#B8A6DE"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.24" Color="#57446F" />
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE8BD;"
                            ToolTip="聊天"
                            Click="ChatMenuItem_Click" />
                    <Button x:Name="QuickScreenshotButton"
                            Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE722;"
                            ToolTip="截图问我"
                            Click="ScreenshotMenuItem_Click" />
                    <Button x:Name="QuickClipboardButton"
                            Style="{StaticResource QuickIconButtonStyle}"
                            Content="&#xE77F;"
                            ToolTip="粘贴问我"
                            Click="ClipboardMenuItem_Click" />
                    <ToggleButton x:Name="QuickMoreButton"
                                  Style="{StaticResource QuickMoreButtonStyle}"
                                  Content="&#xE712;"
                                  ToolTip="更多" />
                </StackPanel>
            </Border>
            <Popup x:Name="QuickMorePopup"
                   PlacementTarget="{Binding ElementName=QuickMoreButton}"
                   Placement="Bottom"
                   HorizontalOffset="-92"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   StaysOpen="False"
                   IsOpen="{Binding IsChecked, ElementName=QuickMoreButton, Mode=TwoWay}">
                <Border Width="132"
                        Padding="6"
                        Background="#FAF8FF"
                        BorderBrush="#B8A6DE"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#57446F" />
                    </Border.Effect>
                    <StackPanel>
                        <Button Style="{StaticResource QuickMoreItemStyle}"
                                Content="♡  陪我玩" Click="InteractMenuItem_Click" />
                        <Button x:Name="QuickTopmostButton"
                                Style="{StaticResource QuickMoreItemStyle}"
                                Content="✓  始终置顶"
                                Click="TopmostMenuItem_Click" />
                        <Button Style="{StaticResource QuickMoreItemStyle}"
                                Content="⏱  效率助手"
                                Click="ProductivityMenuItem_Click" />
                        <Button Style="{StaticResource QuickMoreItemStyle}"
                                Content="⚙  设置"
                                Click="SettingsMenuItem_Click" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Canvas x:Name="PetPropLayer" Panel.ZIndex="11" Visibility="Collapsed">
          <StackPanel x:Name="PetPropBar" Orientation="Vertical"
                      Width="38" Height="118" MouseEnter="PetPropBar_MouseEnter"
                      MouseLeave="PetPropBar_MouseLeave">
            <Button x:Name="PetPropSnack" Style="{StaticResource PetPropButtonStyle}"
                    Margin="2,0,2,6" ToolTip="拖到嘴边投喂"
                    MouseEnter="PetPropSnack_MouseEnter"
                    PreviewMouseLeftButtonDown="PetPropSnack_PreviewMouseLeftButtonDown">
                <Grid Width="22" Height="22">
                    <Ellipse Margin="1" Stroke="#A87545" StrokeThickness="1.3">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.35,0.28">
                                <GradientStop Color="#FFE4AD" Offset="0" />
                                <GradientStop Color="#D99C5F" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="3.4" Height="3.4" Fill="#8F5D43" Margin="-7,-7,0,0" />
                    <Ellipse Width="2.8" Height="2.8" Fill="#9B694B" Margin="7,-3,0,0" />
                    <Ellipse Width="3.2" Height="3.2" Fill="#8F5D43" Margin="-1,8,0,0" />
                    <Ellipse Width="1.8" Height="1.8" Fill="#B77C50" Margin="-10,4,0,0" />
                </Grid>
            </Button>
            <Button x:Name="PetPropDance" Style="{StaticResource PetPropButtonStyle}"
                    Margin="2,0,2,6" ToolTip="点一下，跳支舞"
                    MouseEnter="PetPropDance_MouseEnter"
                    Click="PetPropDance_Click">
                <Grid Width="23" Height="23">
                    <Path Data="M 9,5 L 18,3.5 L 18,15 M 9,5 L 9,18"
                          Stroke="#7653AD" StrokeThickness="2.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                    <Ellipse Width="6.2" Height="4.5" Fill="#7653AD"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="2.5,0,0,1.5" RenderTransform="0.95,0,-0.3,1,0,0" />
                    <Ellipse Width="6.2" Height="4.5" Fill="#7653AD"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,2,4.5" RenderTransform="0.95,0,-0.3,1,0,0" />
                </Grid>
            </Button>
            <Button x:Name="PetPropHop" Style="{StaticResource PetPropButtonStyle}"
                    Margin="2,0,2,0" ToolTip="点一下，蹦一蹦"
                    MouseEnter="PetPropHop_MouseEnter"
                    Click="PetPropHop_Click">
                <Grid Width="23" Height="23">
                    <Path Data="M 11.5,1.5 C 12.6,7.2 15.7,10.4 21.5,11.5 C 15.7,12.6 12.6,15.8 11.5,21.5 C 10.4,15.8 7.3,12.6 1.5,11.5 C 7.3,10.4 10.4,7.2 11.5,1.5 Z"
                          Fill="#8E6AC4" Stroke="#6F4CA6" StrokeThickness="0.6" />
                    <Ellipse Width="2" Height="2" Fill="#FFF9FF" Margin="-2,-6,0,0" />
                </Grid>
            </Button>
          </StackPanel>
          <Border x:Name="PetChoicePanel" Visibility="Collapsed" Padding="6" CornerRadius="12"
                  Background="#FFF9FE" BorderBrush="#BDA7DF" BorderThickness="1"
                  MouseEnter="PetChoicePanel_MouseEnter" MouseLeave="PetChoicePanel_MouseLeave">
            <Border.Effect>
              <DropShadowEffect Color="#684B91" BlurRadius="7" ShadowDepth="2" Opacity="0.22" />
            </Border.Effect>
            <StackPanel>
              <TextBlock x:Name="PetChoiceTitle" FontSize="11" Foreground="#74569F" Margin="3,0,3,4" />
              <StackPanel x:Name="PetChoiceItems" />
            </StackPanel>
          </Border>
        </Canvas>

        <Canvas x:Name="TreatLayer" Panel.ZIndex="12" Visibility="Collapsed">
            <Ellipse x:Name="TreatTarget" Width="40" Height="40" Stroke="#AA9B75C4" StrokeThickness="1.5"
                     StrokeDashArray="2 3" IsHitTestVisible="False" />
            <Border x:Name="TreatToken" Width="36" Height="36" CornerRadius="18" Background="#FFF8EC"
                    BorderBrush="#BDA7DF" BorderThickness="1" Cursor="Hand" Focusable="True"
                    ToolTip="拖到嘴边投喂 · Esc 取消" MouseLeftButtonDown="Treat_MouseDown"
                    MouseMove="Treat_MouseMove" MouseLeftButtonUp="Treat_MouseUp" LostMouseCapture="Treat_LostCapture">
                <Border.Effect>
                    <DropShadowEffect Color="#684B91" BlurRadius="5" ShadowDepth="1" Opacity="0.22" />
                </Border.Effect>
            </Border>
        </Canvas>
        <Grid x:Name="CharacterHost"
              Width="168" Height="220"
              AllowDrop="True"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,0,130,54"
              RenderTransformOrigin="0.5,0.85"
              ContextMenu="{StaticResource PetMenu}"
              MouseEnter="CharacterHost_MouseEnter"
              MouseLeave="CharacterHost_MouseLeave"
              LostMouseCapture="CharacterHost_LostMouseCapture"
              MouseLeftButtonDown="CharacterHost_MouseLeftButtonDown"
              MouseLeftButtonUp="CharacterHost_MouseLeftButtonUp"
              MouseMove="CharacterHost_MouseMove"
              MouseWheel="CharacterHost_MouseWheel"
              MouseRightButtonUp="CharacterHost_MouseRightButtonUp"
              DragEnter="CharacterHost_DragEnter"
              DragOver="CharacterHost_DragOver"
              DragLeave="CharacterHost_DragLeave"
              Drop="CharacterHost_Drop">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PetUserScaleTransform" ScaleX="1" ScaleY="1" />
                    <ScaleTransform x:Name="PetStateScaleTransform" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PetRotateTransform" Angle="0" />
                    <TranslateTransform x:Name="PetTranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Image x:Name="CharacterImage"
                   Stretch="Uniform"
                   Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <Image x:Name="AiCompanion" Width="18" Height="15"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,74,26,0" Stretch="Uniform"
                   RenderTransformOrigin="0.5,0.5"
                   IsHitTestVisible="False" Panel.ZIndex="2"
                   Visibility="Collapsed">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AiCompanionScale" ScaleX="1" ScaleY="1" />
                        <RotateTransform x:Name="AiCompanionRotate" Angle="0" />
                        <TranslateTransform x:Name="AiCompanionTranslate" X="0" Y="0" />
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

            <Border x:Name="AiCompanionHitArea" Width="28" Height="26"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,69,21,0" Background="Transparent"
                    Panel.ZIndex="3" Cursor="Hand"
                    Visibility="{Binding Visibility, ElementName=AiCompanion}" />

            <Viewbox x:Name="PlaceholderCharacter" Stretch="Uniform">
                <Canvas Width="160" Height="210">
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M30,100 C2,89 4,150 30,142 C13,137 20,119 43,126 Z" />
                    <Path Fill="#C9B6F2" Stroke="#8168B2" StrokeThickness="2"
                          Data="M130,100 C158,89 156,150 130,142 C147,137 140,119 117,126 Z" />
                    <Path Fill="#EFE8FF" Stroke="#8067AD" StrokeThickness="2"
                          Data="M112,145 C154,151 151,190 121,181 C142,177 141,162 116,164 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M49,43 C30,4 54,8 66,38 Z" />
                    <Path Fill="#E8DFFF" Stroke="#6E5A98" StrokeThickness="2"
                          Data="M111,43 C130,4 106,8 94,38 Z" />
                    <Ellipse Canvas.Left="33" Canvas.Top="27" Width="94" Height="96" Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2" />
                    <Path Fill="#EEE8F8" Data="M36,70 C40,28 120,24 126,69 C111,52 105,49 95,44 C89,58 70,61 52,55 C49,66 45,77 38,84 Z" />
                    <Ellipse Canvas.Left="55" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="93" Canvas.Top="72" Width="14" Height="19" Fill="#8B70C8" />
                    <Ellipse Canvas.Left="59" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Ellipse Canvas.Left="97" Canvas.Top="75" Width="5" Height="7" Fill="White" />
                    <Path Stroke="#9B7FBB" StrokeThickness="2" Data="M73,99 Q80,104 87,99" />
                    <Path Fill="#F7F3FF" Stroke="#8D76B7" StrokeThickness="2"
                          Data="M58,111 Q80,103 102,111 L119,188 Q80,205 41,188 Z" />
                    <Path Fill="#DCCDF6" Data="M58,113 Q80,126 102,113 L108,145 Q80,156 52,145 Z" />
                    <Ellipse Canvas.Left="72" Canvas.Top="128" Width="16" Height="16" Fill="#8ECFE8" Stroke="#5C91B1" StrokeThickness="1" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M48,132 Q31,147 39,165" />
                    <Path Stroke="#B49BD9" StrokeThickness="3" Data="M112,132 Q129,147 121,165" />
                    <Ellipse Canvas.Left="38" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                    <Ellipse Canvas.Left="84" Canvas.Top="185" Width="38" Height="12" Fill="#65527C" />
                </Canvas>
            </Viewbox>

            <TextBlock x:Name="PetAccentText" HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,28,6,0" Foreground="#9A65BA" FontSize="19" FontWeight="SemiBold"
                       IsHitTestVisible="False" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,0"
                    Background="#D9443659" CornerRadius="10" Padding="8,3" IsHitTestVisible="False">
                <TextBlock x:Name="StateText" Text="待机" Foreground="White" FontSize="11" />
            </Border>
        </Grid>
    </Grid>
</Window>
