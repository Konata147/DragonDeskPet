<Application x:Class="DragonDeskPet.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#8C70D9" />
        <SolidColorBrush x:Key="AccentLightBrush" Color="#EEE8FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#2D2840" />
        <Style x:Key="CourseScrollPageButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CourseScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="27" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Handle" Margin="2,0" Background="#B9A5DE" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#9F83D1" /></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#8466C6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CourseVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="12" Background="Transparent">
                            <Border Width="8" Margin="0,3" Background="#F0EAF8" CornerRadius="4"
                                    HorizontalAlignment="Center" />
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True"
                                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                   ViewportSize="{TemplateBinding ViewportSize}"
                                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource CourseScrollPageButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CourseScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource CourseScrollPageButton}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="CourseHorizontalScrollTemplate" TargetType="ScrollBar">
                <Grid Height="12" Background="Transparent">
                    <Border Height="8" Margin="3,0" Background="#F0EAF8" CornerRadius="4" />
                    <Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False"
                           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource CourseScrollPageButton}" /></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinWidth="27" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb">
                            <Border Background="#B9A5DE" CornerRadius="4" Margin="0,2" />
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource CourseScrollPageButton}" /></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
        </ControlTemplate>
        <Style x:Key="CourseAdaptiveScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource CourseVerticalScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource CourseHorizontalScrollTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#EEE8FF" />
            <Setter Property="Foreground" Value="#382C57" />
        </Style>
    </Application.Resources>
</Application>
